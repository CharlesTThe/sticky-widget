{
  "name": "feedback-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Click-to-comment feedback for any web page: HTML files, React and other apps. Comments go into the file, the browser, or your own Node/Postgres server.",
  "bin": {
    "add-feedback": "bin/add-feedback.mjs",
    "verify-feedback": "bin/verify.mjs",
    "feedback-server": "server/standalone.mjs"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "server": "node server/standalone.mjs",
    "eval": "node evals/run.mjs",
    "test:unit": "node --test test/injector.test.mjs test/snapshot.test.mjs test/server.test.mjs",
    "test:browser": "node --test test/browser.test.mjs test/modes.test.mjs",
    "test": "node build/build.mjs && npm run test:unit && node evals/run.mjs && node test/strict-browser.mjs",
    "test:pg": "node --test test/server.test.mjs test/modes.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "pg-mem": "^3.0.14",
    "playwright-core": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "main": "dist/widget.min.js",
  "module": "dist/feedback-kit.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/feedback-kit.mjs",
      "default": "./dist/feedback-kit.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./server/index.mjs"
    },
    "./script": "./dist/widget.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "types/",
    "server/",
    "bin/",
    "references/",
    "SKILL.md",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "feedback",
    "annotations",
    "review",
    "comments",
    "widget",
    "react",
    "html",
    "shadow-dom"
  ]
}
